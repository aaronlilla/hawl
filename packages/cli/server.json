{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aaronlilla/hawl",
  "title": "Hawl",
  "description": "Mailbox, handoffs and permits between your coding agents. Local mode needs no account.",
  "version": "0.1.3",
  "websiteUrl": "https://hawl.ai",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "hawl.ai",
      "version": "0.1.3",
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "named", "name": "--host", "value": "claude_code" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
