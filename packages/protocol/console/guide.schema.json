{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/console/guide.schema.json",
  "title": "Console WS guide",
  "description": "Ids only. A nudge that something the setup guide or the agents-meeting panel reads has changed; the page reads the relay again.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "guide"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "town_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_twn"
    },
    "at": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/timestamp"
    },
    "event": {
      "enum": [
        "intro.sent",
        "rolepack.read",
        "role.matched",
        "agreement.proposed",
        "agreement.accepted",
        "agreement.countered",
        "agreement.live",
        "agreement.ended",
        "signoff.recorded",
        "charter.saved",
        "rolepack.written"
      ]
    },
    "agreement_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "resident_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "role_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "handoff_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "revision": { "type": "integer", "minimum": 0 }
  },
  "required": ["t", "seq", "town_id", "at", "event"]
}
