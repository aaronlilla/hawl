{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/console/subscribe.schema.json",
  "title": "Console WS subscribe",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "subscribe"
    },
    "streams": {
      "type": "array",
      "items": {
        "enum": ["feed", "handoffs", "workers", "needs_action", "files", "map"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "after_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["t", "streams"]
}
