{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/file_get.result.schema.json",
  "title": "file_get result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "name": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["path", "sha256"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/file_state"
        },
        "reason": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "download": {
          "type": "string"
        }
      },
      "required": ["state"]
    }
  ]
}
