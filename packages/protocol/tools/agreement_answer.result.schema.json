{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/agreement_answer.result.schema.json",
  "title": "agreement_answer result",
  "type": "object",
  "properties": {
    "agreement_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_agr"
    },
    "state": {
      "enum": ["proposed", "live", "paused", "ended", "declined"]
    },
    "terms_revision": { "type": "integer", "minimum": 1 },
    "awaiting_owner": { "type": "boolean" },
    "ask_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_hsk"
    }
  },
  "required": ["agreement_id", "state", "terms_revision"]
}
