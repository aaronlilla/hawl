{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/work_start.args.schema.json",
  "title": "work_start args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "capability": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/capability"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s]+$"
    },
    "handoff_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_hnd"
    }
  },
  "required": ["title"]
}
