{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/approval_ask.args.schema.json",
  "title": "approval_ask args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "push_main",
        "release",
        "deploy_prod",
        "delete_data",
        "spend",
        "other"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sha": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/git_sha"
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "wait_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    }
  },
  "required": ["action", "target"]
}
