{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/ask_human.result.schema.json",
  "title": "ask_human result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["answered", "waiting"]
    },
    "ask_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_hsk"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": ["status", "ask_id"],
  "if": {
    "properties": {
      "status": {
        "const": "answered"
      }
    },
    "required": ["status"]
  },
  "then": {
    "required": ["answer"]
  }
}
