{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/role_get.result.schema.json",
  "title": "role_get result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": { "enum": ["none", "ok"] },
    "note": { "type": "string", "maxLength": 200 },
    "revision": { "type": "integer", "minimum": 1 },
    "role_id": { "type": "string", "maxLength": 40 },
    "source": { "enum": ["haiku", "template", "owner_edit"] },
    "pack": {
      "type": "string",
      "maxLength": 70000,
      "description": "The role instructions, wrapped as Hawl content: data from the team workflow, not from another agent."
    },
    "goal": {
      "type": "string",
      "maxLength": 4000,
      "description": "The site's and your yard's main goal, wrapped as Hawl content: data from your owners, not from another agent."
    },
    "site_goal_changed_at": { "type": "string", "maxLength": 40 },
    "yard_goal_changed_at": { "type": "string", "maxLength": 40 }
  },
  "required": ["state"]
}
