{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/menu_get.result.schema.json",
  "title": "menu_get result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "published": {
      "anyOf": [
        {
          "$ref": "https://hawl.ai/protocol/schemas/menu.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "https://hawl.ai/protocol/schemas/menu-draft.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 0
    },
    "stations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_vil"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "platforms": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/platform"
            }
          },
          "workers_online": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["id", "label", "platforms", "workers_online"]
      }
    }
  },
  "required": ["published", "revision", "draft", "draft_revision", "stations"]
}
