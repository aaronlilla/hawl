{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/thread_read.result.schema.json",
  "title": "thread_read result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_msg"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70000
          }
        },
        "required": ["message_id", "text"]
      },
      "maxItems": 100
    }
  },
  "required": ["messages"]
}
