{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/thread_read.args.schema.json",
  "title": "thread_read args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_cnv",
      "description": "The cnv_... id (not a message or handoff id). Example: cnv_01926f3a-0000-7000-8000-000000000001"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Messages to return. Example: 20."
    }
  },
  "required": ["conversation_id"]
}
