{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/job_open.result.schema.json",
  "title": "job_open result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "routed",
        "held_for_owner",
        "suggested",
        "clarify",
        "needs_human"
      ]
    },
    "handoff_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_hnd"
    },
    "to_yard": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/yard_ref"
    },
    "explain": {
      "$ref": "https://hawl.ai/protocol/schemas/route-explain.schema.json"
    },
    "choices": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/capability"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "required": ["capability", "label"]
      }
    }
  },
  "required": ["decision", "explain"]
}
