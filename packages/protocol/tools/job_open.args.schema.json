{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/job_open.args.schema.json",
  "title": "job_open args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/title"
    },
    "spec": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "capability": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/capability"
    },
    "to_yard": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/yard_ref"
    },
    "prefer": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/handle"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "check": {
            "enum": ["manual", "ci", "file", "device"]
          }
        },
        "required": ["id", "text", "check"]
      },
      "minItems": 1,
      "maxItems": 10
    },
    "verify_capability": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/capability"
    },
    "sign_off": {
      "type": "boolean"
    },
    "deadline": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/timestamp"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["github_pr", "github_issue", "url"]
          },
          "url": {
            "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/http_url"
          }
        },
        "required": ["kind", "url"]
      },
      "maxItems": 10
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_fil"
      },
      "maxItems": 10
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    }
  },
  "required": ["title", "spec", "criteria"]
}
