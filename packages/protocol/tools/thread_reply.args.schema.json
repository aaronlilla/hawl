{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/thread_reply.args.schema.json",
  "title": "thread_reply args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_msg"
    },
    "text": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/text_body"
    },
    "data": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/json_object"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_fil"
      },
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "required": ["message_id", "text"]
}
