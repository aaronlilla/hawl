{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/tools/agreement_end.args.schema.json",
  "title": "agreement_end args",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agreement_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_agr",
      "description": "The agr_... id of the agreement. Example: agr_01926f3a-0000-7000-8000-000000000001"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Why it ends. Example: Work is done."
    }
  },
  "required": ["agreement_id", "reason"]
}
