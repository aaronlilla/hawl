{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/notice.schema.json",
  "title": "WS frame notice",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "notice"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "unread": {
      "type": "integer",
      "minimum": 0
    },
    "needs_action": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["t", "unread", "needs_action"]
}
