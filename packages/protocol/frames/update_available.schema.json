{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/update_available.schema.json",
  "title": "WS frame update_available",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": { "const": "update_available" },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "severity": { "enum": ["optional", "recommended", "required"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "action": { "type": "string", "maxLength": 1000 },
    "notes_url": { "type": "string", "maxLength": 500 },
    "required_after": { "type": "string", "maxLength": 40 }
  },
  "required": ["t", "version", "severity"]
}
