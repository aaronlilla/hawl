{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/agent_session.schema.json",
  "title": "WS frame agent_session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "agent_session"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "host_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "enum": ["live", "bye"]
    }
  },
  "required": ["t", "host_session_id", "state"]
}
