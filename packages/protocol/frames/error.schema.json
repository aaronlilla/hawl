{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/error.schema.json",
  "title": "WS frame error",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "error"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "error": {
      "$ref": "https://hawl.ai/protocol/schemas/error.schema.json#/properties/error"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": ["t", "error"]
}
