{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/activity.schema.json",
  "title": "WS frame activity (spec 16 section 3.9)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "activity"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "session_start",
              "session_stop",
              "subagent_start",
              "subagent_stop",
              "tool_before",
              "tool_after",
              "model_call",
              "process_start",
              "process_exit"
            ]
          },
          "source": {
            "enum": ["hook", "otlp", "proc"]
          },
          "ts": {
            "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/timestamp"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "agent_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "parent_pid": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "exit_code": {
            "type": ["integer", "null"]
          }
        },
        "required": ["kind", "source", "ts"]
      }
    }
  },
  "required": ["t", "events"]
}
