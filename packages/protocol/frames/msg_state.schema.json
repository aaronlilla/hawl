{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/msg_state.schema.json",
  "title": "WS frame msg.state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "msg.state"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "message_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_msg"
    },
    "state": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/message_state"
    },
    "approval_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_apr"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": ["t", "message_id", "state"]
}
