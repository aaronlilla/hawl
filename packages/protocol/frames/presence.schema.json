{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/protocol/frames/presence.schema.json",
  "title": "WS frame presence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "presence"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "resident_id": {
      "$ref": "https://hawl.ai/protocol/schemas/common.schema.json#/$defs/id_res"
    },
    "status": {
      "enum": ["idle", "busy", "away", "offline"]
    }
  },
  "required": ["t", "resident_id", "status"]
}
