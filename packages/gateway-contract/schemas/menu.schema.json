{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/gateway-contract/schemas/menu.schema.json",
  "title": "Gateway menu",
  "description": "Published by a yard gateway on join and on change (12 section 9.1 item 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["yard", "owner", "display_name", "visibility", "capabilities"],
  "properties": {
    "yard": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Yard slug."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "summary", "full"]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accept_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "auto_accept": {
          "type": "boolean"
        },
        "daily_budget_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Capability slug."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "quality_bar": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "typical_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "accepts_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/([a-z0-9.+-]+|\\*)$"
          }
        }
      }
    }
  }
}
