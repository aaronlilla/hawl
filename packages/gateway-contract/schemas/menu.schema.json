{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hawl.ai/gateway-contract/schemas/menu.schema.json",
  "title": "Gateway menu",
  "description": "Published by a yard gateway on join and on change (12 section 9.1 item 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["yard", "owner", "display_name", "visibility", "capabilities"],
  "properties": {
    "yard": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Yard slug."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "summary", "full"]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accept_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "auto_accept": {
          "type": "boolean"
        },
        "daily_budget_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "hold_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080,
      "description": "m2: ping the owner when no agent of the yard came online this long after accepting (default 240)."
    },
    "release_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 43200,
      "description": "m2: give a still-queued job back to the Dispatcher after this long (default 1440)."
    },
    "direct_lines": {
      "type": "string",
      "enum": ["job_parties", "ask_owner", "never"],
      "description": "m2: who may open a direct line to one of this yard's agents for a job."
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Capability slug."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "quality_bar": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "typical_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "accepts_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/([a-z0-9.+-]+|\\*)$"
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": "m2: words that route free text to this capability by rule."
        },
        "stations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^vil_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": "m2: stations (folder yards, vil_ ids) that do this work."
        },
        "approval": {
          "type": "string",
          "enum": ["auto", "ask_owner"],
          "description": "m2: accept on the yard's behalf, or ask the owner first."
        },
        "accept_from": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "description": "m2: \"site\" (anyone in the site) or yard slugs."
        },
        "accept_when_offline": {
          "type": "boolean",
          "description": "m2: accept and queue while every agent of the yard is offline."
        },
        "open": {
          "type": "boolean",
          "description": "m2: false closes the capability without removing it."
        },
        "next": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "description": "m2: capabilities this work usually leads to (likely-next hints)."
        }
      }
    }
  }
}
